{
  "name": "local-live-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI tutoring application (see Local Live Tutor PRD)",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @local-live-tutor/shared build && pnpm -r --parallel dev",
    "test": "pnpm --filter @local-live-tutor/shared build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @local-live-tutor/frontend e2e"
  }
}
