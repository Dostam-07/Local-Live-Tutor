# Copy to .env and adjust. All values optional — sensible local defaults.

# --- Server ---
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# --- LLM provider (PRD §5.7) ---
# ollama (local, private) | openrouter (free-model pool).
# "mock" is internal test infrastructure only — never a user choice.
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Server-side only — never exposed to the browser (PRD §7, §13).
OPENROUTER_API_KEY=
# Explicit-consent fallback across providers (PRD §5.7). Default: off.
ALLOW_PROVIDER_FALLBACK=false

# --- Storage (PRD §19) ---
DATABASE_URL=./data/tutor.sqlite
UPLOAD_DIR=./data/uploads
